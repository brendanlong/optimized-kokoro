# The GPU worker image. Build from worker/:  podman build -t localhost/kokoro-worker -f Containerfile .
# Weights are not baked in: run.sh mounts the directory kokoro_worker.convert wrote, read-only.

FROM docker.io/nvidia/cuda:12.6.3-base-ubuntu24.04 AS builder
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends git ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.11.4 /uv /usr/local/bin/uv
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_NO_CONFIG=1
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --managed-python

FROM docker.io/nvidia/cuda:12.6.3-base-ubuntu24.04
# Triton (torch.compile) builds a small launcher with the system C compiler at first use.
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends gcc libc6-dev && \
    rm -rf /var/lib/apt/lists/* && \
    useradd -m -u 1001 worker
COPY --from=builder /opt/uv-python /opt/uv-python
COPY --from=builder /app/.venv /app/.venv
COPY kokoro_worker /app/kokoro_worker
WORKDIR /app
USER worker
# The root filesystem is read-only at run time; compile caches go to a tmpfs at /tmp.
ENV PATH=/app/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp \
    TRITON_CACHE_DIR=/tmp/triton \
    TORCHINDUCTOR_CACHE_DIR=/tmp/inductor \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    CUDA_MODULE_LOADING=LAZY
ENTRYPOINT ["python", "-m", "kokoro_worker.server", "--socket", "/run/kokoro/worker.sock", "--models", "/models"]
