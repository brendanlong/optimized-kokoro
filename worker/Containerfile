# The GPU worker image. Build from worker/:  podman build -t localhost/kokoro-worker -f Containerfile .
# Weights are not baked in: run.sh mounts the directory kokoro_worker.convert wrote, read-only.
#
# Pinned: base images by digest, apt packages from a dated Ubuntu snapshot (plus top-level
# versions), Python by patch version (.python-version), and every Python package by uv.lock.

ARG UBUNTU_SNAPSHOT=20261101T000000Z

FROM ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 AS uv

FROM docker.io/nvidia/cuda:13.4.3-base-ubuntu24.04@sha256:07adb6792c59025f2c45bfb1a3f1d1148bf6d48bf2326d604a6b2e24c4f04d6f AS base
ARG UBUNTU_SNAPSHOT
# The worker needs nothing from NVIDIA's apt repo (torch's wheels bring CUDA), so drop it, and read
# Ubuntu's archive as it was on UBUNTU_SNAPSHOT.
RUN rm -f /etc/apt/sources.list.d/cuda*.list && \
    sed -i -e "s|http://archive.ubuntu.com/ubuntu/|https://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}/|" \
           -e "s|http://security.ubuntu.com/ubuntu/|https://snapshot.ubuntu.com/ubuntu/${UBUNTU_SNAPSHOT}/|" \
           /etc/apt/sources.list.d/ubuntu.sources

FROM base AS builder
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends git=1:2.43.0-1ubuntu7.4 && \
    rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_NO_CONFIG=1
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --managed-python

FROM base
# Triton (torch.compile) builds a small launcher with the system C compiler at first use.
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends gcc=4:13.2.0-7ubuntu1 libc6-dev=2.39-0ubuntu8.9 && \
    rm -rf /var/lib/apt/lists/* && \
    useradd -m -u 1001 worker
COPY --from=builder /opt/uv-python /opt/uv-python
COPY --from=builder /app/.venv /app/.venv
COPY kokoro_worker /app/kokoro_worker
WORKDIR /app
# run.sh overrides this with the calling user's uid and deploy/compose.yaml with 65534 (nobody), so
# nothing may depend on it.
USER worker
# The root filesystem is read-only at run time; compile caches go to a tmpfs at /tmp.
ENV PATH=/app/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp \
    TRITON_CACHE_DIR=/tmp/triton \
    TORCHINDUCTOR_CACHE_DIR=/tmp/inductor \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    CUDA_MODULE_LOADING=LAZY
ENTRYPOINT ["python", "-m", "kokoro_worker.server", "--socket", "/run/kokoro/worker.sock", "--models", "/models"]
